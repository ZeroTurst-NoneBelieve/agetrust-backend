# Issuer(발급자) Ed25519 개인키 — base64(raw 32바이트)
#
# ⚠️ 팀에서 공유하는 키를 넣으세요. (gayeoniii에게 요청)
#    발급자 키는 프로젝트에 하나여야 합니다. 각자 다른 키를 쓰면
#    서로 발급한 VC가 검증되지 않고, 체인에 등록할 공개키도 확정되지 않습니다.
#
# 혼자 로컬 테스트만 할 때는 아래로 임시 생성 가능:
# python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; from cryptography.hazmat.primitives.serialization import Encoding, PrivateFormat, NoEncryption; import base64; k=Ed25519PrivateKey.generate(); print(base64.b64encode(k.private_bytes(Encoding.Raw, PrivateFormat.Raw, NoEncryption())).decode())"
#
# 절대 커밋하지 마세요. Public 레포입니다. (#18 보관 정책 확정 전까지 임시 방식)
ISSUER_PRIVATE_KEY=
# 개발 편의 기능 스위치 (OTP를 응답과 콘솔에 노출)
# 로컬 개발·시연 시에만 true. 배포 환경에서는 절대 켜지 마세요.
# 켜져 있으면 전화번호만 알면 SMS 없이 인증을 통과할 수 있습니다.
# 값을 적지 않으면 false입니다. 명시적으로 켜야만 켜집니다. (#24)
DEV_MODE=true

# ── Kafka / Outbox Publisher (#9) ──────────────────────────────────
# 시크릿이 아니라 환경마다 달라지는 값입니다. 아래는 docker compose 기준
# 기본값이며, 그대로 두어도 동작합니다.
#
# 주의: 이 값들을 바꾸려면 docker-compose.yml의 backend.environment에도
# 같은 이름이 있어야 합니다. .env는 컨테이너 안으로 들어가지 않고
# docker compose의 ${} 치환에만 쓰이기 때문입니다.

# 브로커 주소. 컨테이너끼리는 kafka:29092, 호스트에서는 localhost:9092.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# 감사 이벤트를 발행할 토픽.
KAFKA_AUDIT_TOPIC=agetrust.audit-events

# Publisher를 띄울지 여부. Kafka 없이 API만 띄우고 싶을 때 false.
KAFKA_PUBLISHER_ENABLED=true

# 미발행 이벤트를 훑는 주기(초).
OUTBOX_POLL_INTERVAL_SECONDS=2.0

# 한 번에 가져올 이벤트 수.
OUTBOX_PUBLISH_BATCH_SIZE=100

# 이 횟수만큼 실패하면 해당 이벤트는 더 이상 발행하지 않습니다.
# 깨진 이벤트 하나가 뒤의 정상 이벤트를 막지 않도록 하기 위한 것이며,
# 한도에 도달하면 ERROR 로그가 남습니다. 감사 원장(audit_logs)에는
# 그대로 남아 있고 Kafka 구독자에게만 전달되지 않습니다.
OUTBOX_MAX_RETRY_COUNT=10