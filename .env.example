# ── PostgreSQL (필수) ────────────────────────────────────────────────
# docker compose가 DB 컨테이너 초기화와 backend의 DATABASE_URL 조립에
# 씁니다. 셋 중 하나라도 비어 있으면 `docker compose up`이
# "POSTGRES_USER is required" 로 멈춥니다.
POSTGRES_USER=agetrust
POSTGRES_PASSWORD=
POSTGRES_DB=agetrust

# 호스트에서 직접 실행할 때(uvicorn, alembic, unittest) 쓰는 접속 문자열입니다.
# 컨테이너 안에서는 docker-compose.yml이 위 세 값으로 따로 조립하므로
# 이 값을 쓰지 않습니다. 위 세 값과 어긋나지 않게 맞추세요.
DATABASE_URL=postgresql+asyncpg://agetrust:<password>@localhost:5432/agetrust

# ── 앱 시크릿 (필수) ─────────────────────────────────────────────────────
# JWT 서명 키. 32바이트 이상의 임의 문자열을 쓰세요.
# 값이 바뀌면 이미 발급한 액세스·리프레시 토큰이 전부 무효가 됩니다.
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# ── Issuer(발급자) 키 (필수) ─────────────────────────────────────────────
# Issuer(발급자) Ed25519 개인키 — base64(raw 32바이트)
#
# ⚠️ 팀에서 공유하는 키를 넣으세요. (gayeoniii에게 요청)
#    발급자 키는 프로젝트에 하나여야 합니다. 각자 다른 키를 쓰면
#    서로 발급한 VC가 검증되지 않습니다. 이 값이 바뀌면 발급자 DID가 통째로
#    바뀌어, 이미 발급된 VC와 서버가 서로 다른 발급자가 됩니다.
#
# 혼자 로컬 테스트만 할 때는 아래로 임시 생성 가능:
# python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; from cryptography.hazmat.primitives.serialization import Encoding, PrivateFormat, NoEncryption; import base64; k=Ed25519PrivateKey.generate(); print(base64.b64encode(k.private_bytes(Encoding.Raw, PrivateFormat.Raw, NoEncryption())).decode())"
#
# ⚠️ 서버를 다시 세우다 이 값이 비었을 때 새로 만들지 마세요. 정본 키를 받아서
#    채웁니다. 새로 만들어도 앱은 정상 기동하지만 발급자 DID가 갈리고,
#    아무 에러도 나지 않아 한참 뒤에야 드러납니다.
#
# 절대 커밋하지 마세요. Public 레포입니다.
# 보관·회전 정책은 ADR-0015(agetrust-docs)를 따릅니다.
ISSUER_PRIVATE_KEY=
# ── 개발 편의 (선택) ─────────────────────────────────────────────────────
# 개발 편의 기능 스위치 (OTP를 응답과 콘솔에 노출)
# 로컬 개발·시연 시에만 true. 배포 환경에서는 절대 켜지 마세요.
# 켜져 있으면 전화번호만 알면 SMS 없이 인증을 통과할 수 있습니다.
# 값을 적지 않으면 false입니다. 명시적으로 켜야만 켜집니다. (#24)
DEV_MODE=true

# ── Kafka / Outbox Publisher (#9) ──────────────────────────────────
# 시크릿이 아니라 환경마다 달라지는 값입니다. 아래는 docker compose 기준
# 기본값이며, 그대로 두어도 동작합니다.
#
# 주의: 이 값들을 바꾸려면 docker-compose.yml의 backend.environment에도
# 같은 이름이 있어야 합니다. .env는 컨테이너 안으로 들어가지 않고
# docker compose의 ${} 치환에만 쓰이기 때문입니다.

# 브로커 주소. 컨테이너끼리는 kafka:29092, 호스트에서는 localhost:9092.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# 감사 이벤트를 발행할 토픽.
KAFKA_AUDIT_TOPIC=agetrust.audit-events

# Publisher를 띄울지 여부. Kafka 없이 API만 띄우고 싶을 때 false.
KAFKA_PUBLISHER_ENABLED=true

# 미발행 이벤트를 훑는 주기(초).
OUTBOX_POLL_INTERVAL_SECONDS=2.0

# 한 번에 가져올 이벤트 수.
OUTBOX_PUBLISH_BATCH_SIZE=100

# 이 횟수만큼 실패하면 해당 이벤트는 더 이상 발행하지 않습니다.
# 깨진 이벤트 하나가 뒤의 정상 이벤트를 막지 않도록 하기 위한 것이며,
# 한도에 도달하면 ERROR 로그가 남습니다. 감사 원장(audit_logs)에는
# 그대로 남아 있고 Kafka 구독자에게만 전달되지 않습니다.
OUTBOX_MAX_RETRY_COUNT=10

# ── StatusList2021 폐기 목록 (#27) ─────────────────────────────────
# 발급되는 VC 안에 박히는 공개 주소입니다. 키오스크가 이 주소로 폐기 목록을
# 받아가므로, 키오스크에서 실제로 접근 가능한 값이어야 합니다.
# 한 번 발급된 VC 안의 주소는 나중에 고칠 수 없으니 시연 전에 맞춰두세요.
# 다른 기기에서 붙는다면 노트북의 LAN IP를 적으세요.
# powershell 창에 'ipconfig' 입력 후 IP 값 확인 할 수 있습니다.
# 예: PUBLIC_BASE_URL=http://본인 IP주소 값:8000
PUBLIC_BASE_URL=http://localhost:8000
